# AI-MCP-Containers: copy this file to .env and choose local paths explicitly.
# Generate a private key with: openssl rand -hex 32
# The service refuses empty keys and keys shorter than 32 characters.
AI_MCP_TOKEN=

# Discover active physical Ethernet/Wi-Fi private IPv4 addresses at startup.
# Requires Linux and a local Docker Unix socket. Docker/VPN interfaces are excluded.
# Set one host private IPv4 to restrict LAN access, or leave empty to disable it.
# Localhost and Docker-network access remain available in every mode.
AI_MCP_LAN_IP=auto

# Only this host directory tree is mounted for project/review access.
# The mount is read-only. Choosing a parent exposes ALL readable descendants,
# including other projects and their .env files. Use narrow paths when possible.
AI_MCP_PROJECT_ROOT=/absolute/path/to/selected/project

# Host credential owner. Fill these with the output of id -u and id -g.
AI_MCP_HOST_UID=1000
AI_MCP_HOST_GID=1000

# Stable Linux x64 Codex binary copy, maintained by refresh-codex-bin.sh.
# Use a dedicated directory outside project trees; the updater synchronizes its contents.
# HOME is expanded by Docker Compose on this host; no owner-specific paths ship.
AI_MCP_CODEX_EXT_BIN=${HOME}/.codex-ext-bin
# Claude resolves the latest compatible stable extension on every invocation.
AI_MCP_CLAUDE_EXTENSIONS=${HOME}/.vscode/extensions

# Global concurrent requests per provider, including different conversation IDs.
AI_MCP_MAX_CONCURRENT_REQUESTS=6

# Native CODEX_HOME, HOME and CLAUDE_CODE_TMPDIR are provider-owned variables.
# The service manages them; do not replace provider-native names with AI_MCP names.
# Project write access is disabled. Credential refresh and private runtime state
# still need writable storage; this is not a sandbox for untrusted model prompts.
