# Copy to the ignored .env.desktop. Use Docker Desktop with Linux containers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_MCP_TOKEN=

# One existing project directory. Use forward slashes on Windows, for example
# 'C:/Users/YourName/Projects/MyApp', or '/Users/YourName/Projects/MyApp' on macOS.
# Single quotes prevent Compose from expanding dollar signs in directory names.
AI_MCP_PROJECT_ROOT='/absolute/path/to/your/project'
AI_MCP_MAX_CONCURRENT_REQUESTS=6
AI_MCP_MAX_PROMPT_CHARS=1000000
